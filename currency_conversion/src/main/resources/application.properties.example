spring.application.name=currency_conversion
server.port=${PORT:8080}

openexchangerates.app-id=your_app_id_here

spring.mongodb.uri=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@conversion.fwndu50.mongodb.net/currencydb?retryWrites=true&w=majority

spring.data.redis.host=your_redis_host
spring.data.redis.port=6379
spring.data.redis.password=your_redis_password
spring.data.redis.ssl.enabled=true

spring.cache.type=redis
spring.cache.redis.time-to-live=3600000
spring.cache.redis.cache-null-values=false
